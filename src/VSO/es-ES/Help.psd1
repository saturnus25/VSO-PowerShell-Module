@{
    Parameters=@{
        WhatIf='Muestra la operación prevista sin descargas, cambios de archivos, cierre de procesos ni elevación.'
        Confirm='Solicita confirmación mediante ShouldProcess de PowerShell. Respeta la confirmación explícita; no se puede combinar con Quiet.'
        Path='Raíz local absoluta de instalación gestionada. El paquete oficial permanece en su subcarpeta VSO7 para evitar el traslado de primer inicio de la aplicación. Admite espacios y Unicode. Rechaza UNC, temporales, raíces protegidas, enlaces y metacaracteres de shell. Nunca usa el directorio de trabajo como destino predeterminado.'
        Scope='CurrentUser o AllUsers. CurrentUser es el valor seguro en automatización; Install-VSO pregunta en modo interactivo si se omiten ámbito y ruta.'
        AllUsers='Selecciona AllUsers. Entra en conflicto con Scope CurrentUser explícito. Requiere administrador y una carpeta padre existente protegida.'
        Version='Versión semántica de una release de VSO; admite prefijo v. Independiente de la versión del módulo. Update -Force permite reinstalar o bajar de versión explícitamente.'
        Prerelease='Incluye releases preliminares. Obligatorio al elegir una versión preliminar explícita. Desactivado de forma predeterminada.'
        AssetName='Nombre exacto del ZIP de distribución publicado en la release. Obligatorio si hay varios ZIP.'
        Force='Omite la confirmación predeterminada si no se especificó Confirm. Permite reinstalar o bajar de versión de forma verificada. En Stop autoriza el cierre forzado. No omite las comprobaciones de seguridad.'
        Quiet='Sin preguntas, ventanas, UAC ni progreso. Usa valores seguros de instalación. Falla si hay selección ambigua o se requiere elevación. Reset requiere además Force.'
        Language='es, es-ES, en o en-US. Las culturas españolas usan español; las restantes usan inglés de respaldo. Valor predeterminado: PSUICulture.'
        PassThru='Devuelve un resultado estructurado o los metadatos de Help-VSO. Reset -WhatIf -PassThru devuelve el plan exacto de eliminación.'
        Full='Elimina además configuración, caché, logs, temporales registrados sin cambios y metadatos atribuibles de transacciones del gestor. Conserva el estado compartido de VSO7 y los archivos de ejecución sin prueba de propiedad. No revierte tweaks ni desinstala este módulo.'
        RemoveBackups='Elimina también archivos de aplicación propios y sin cambios en copias anteriores del gestor. Requiere Full y AcknowledgeBackupLoss. Conserva archivos desconocidos y Recovery compartido.'
        AcknowledgeBackupLoss='Reconoce explícitamente la pérdida de las copias anteriores de la aplicación. Obligatorio con RemoveBackups, incluso en automatización.'
        AllowUnregistered='Autoriza explícitamente abrir una distribución manual tras validar layout y checksums internos. El gestor no ha establecido su origen oficial.'
        Command='Comando público que se desea consultar. Si se omite, muestra los ocho comandos.'
        Examples='Muestra los ejemplos del comando seleccionado.'
    }
    Defaults=@{WhatIf='False';Confirm='ConfirmPreference';Scope='CurrentUser en automatización; selección en modo interactivo';Language='PSUICulture con respaldo explícito en inglés';Path='LOCALAPPDATA\Programs\VSO o ProgramFiles\VSO';Version='Última release estable en Install/Update; todas las coincidentes en consultas';Prerelease='False';Force='False';Quiet='False';Full='False';RemoveBackups='False';AcknowledgeBackupLoss='False';PassThru='False';AllowUnregistered='False';Examples='False'}
    'Install-VSO'=@{Synopsis='Descarga, valida e instala la distribución oficial de VSO.';Description='La selección interactiva de ámbito y carpeta usa opciones nativas. Scope o AllUsers omiten solo la selección de ámbito; si la sesión es interactiva, sigue preguntando por el destino. Path solo resuelve CurrentUser sin preguntas. CurrentUser usa LOCALAPPDATA; AllUsers usa ProgramFiles. Valida activos oficiales, SHA-256 del ZIP, límites de extracción y todos los checksums internos antes de mover archivos. Conserva archivos desconocidos; una instalación existente requiere Update o Force. Quiet no abre UAC. WhatIf no crea archivos ni consulta la red.';Examples=@(@{Title='Instalación interactiva';Code='Install-VSO';Remarks='Elige ámbito y ruta predeterminada o selecciona una carpeta.'},@{Title='Instalación automatizada';Code='Install-VSO -Scope CurrentUser -Version 1.2.2 -Quiet -PassThru';Remarks='Sin preguntas y con valores seguros.'},@{Title='Ruta personalizada';Code='Install-VSO -Path "D:\Programs\VSO" -Language es';Remarks='La ruta absoluta explícita resuelve la elección de carpeta.'},@{Title='Vista previa para todos';Code='Install-VSO -AllUsers -WhatIf';Remarks='No crea UAC, bloqueo, descarga ni staging.'})}
    'Start-VSO'=@{Synopsis='Abre la instalación seleccionada mediante su lanzador oficial.';Description='Revalida los archivos propios y START VSO7.bat. El batch elige Windows PowerShell 5.1 y gestiona la elevación de VSO. Detecta instancias de forma conservadora. Si falta visibilidad de procesos, falla de forma segura. Start no incluye Quiet porque abre una ventana de aplicación expresamente. PassThru confirma la creación del lanzador, no el arranque completo. Las instalaciones manuales requieren AllowUnregistered.';Examples=@(@{Title='Abrir';Code='Start-VSO';Remarks='Permite seleccionar si hay varias instalaciones.'},@{Title='Abrir una instalación concreta';Code='Start-VSO -Path "D:\Programs\VSO" -PassThru';Remarks='Consulta LauncherProcessId y StartupVerified.'})}
    'Stop-VSO'=@{Synopsis='Cierra únicamente procesos atribuidos estrictamente a VSO.';Description='Comprueba el lanzador exacto, la ruta de script o el origen y SHA-256 del host protegido en memoria. No cierra Windows Terminal ni descendientes arbitrarios. Revalida PID, fecha de creación y línea de comandos antes de terminar. VSO7 no tiene un contrato IPC de cierre limpio verificado: sin Force debes cerrarlo manualmente. Force autoriza una interrupción, potencialmente durante Recovery. Si falta visibilidad, falla; Force interactivo puede solicitar UAC.';Examples=@(@{Title='Vista previa';Code='Stop-VSO -Path "D:\Programs\VSO" -WhatIf';Remarks='Consulta los PID atribuidos.'},@{Title='Cierre forzado explícito';Code='Stop-VSO -Path "D:\Programs\VSO" -Force -PassThru';Remarks='Considera antes el trabajo pendiente y Recovery.'})}
    'Update-VSO'=@{Synopsis='Actualiza una instalación gestionada con reemplazo transaccional verificado.';Description='Consulta releases oficiales y compara versiones semánticas. Omite versiones iguales o anteriores salvo Force explícito. Copia configuración, backups y archivos desconocidos a la nueva instalación; conserva el directorio anterior. Ante un fallo restaura la carpeta previa cuando es posible. Una transacción interrumpida ambigua falla indicando su journal. Los procesos activos o sin visibilidad bloquean el reemplazo. Rechaza migraciones entre generaciones.';Examples=@(@{Title='Actualizar a estable';Code='Update-VSO -Quiet -PassThru';Remarks='Requiere una instalación inequívoca y permisos suficientes.'},@{Title='Vista previa';Code='Update-VSO -Path "D:\Programs\VSO" -WhatIf';Remarks='No descarga, eleva ni reemplaza.'},@{Title='Reinstalación explícita';Code='Update-VSO -Version 1.2.2 -Force';Remarks='Mantiene las comprobaciones de integridad y propiedad.'})}
    'Get-VSOInstallation'=@{Synopsis='Enumera registros de instalación y descubrimientos limitados en rutas predeterminadas.';Description='Sin coincidencias devuelve una colección vacía, también en uso interactivo; Get-VSOStatus ofrece un resumen explícito de ausencia. Una ruta Path inexistente devuelve Missing; las carpetas incompletas o inválidas, Modified; una distribución válida sin recibo, Unregistered. Los errores de acceso al índice no se ocultan como resultados vacíos. Path admite cadenas o propiedades Path por canalización. Devuelve objetos con versión, generación, ámbito, ruta, estado, recibo y diagnóstico. No pregunta ni escanea unidades. Path permite inspeccionar una instalación manual; sus checksums internos no prueban el origen oficial. Informa de instalaciones ausentes o modificadas. No crea archivos ni claves del Registro.';Examples=@(@{Title='Enumerar';Code='Get-VSOInstallation | Select-Object Version, Scope, Path, State';Remarks='Puedes filtrar los objetos y usarlos en scripts.'},@{Title='Inspeccionar una carpeta';Code='Get-VSOInstallation -Path "D:\Programs\VSO" -Language es';Remarks='Inspección de solo lectura.'})}
    'Get-VSOStatus'=@{Synopsis='Consulta integridad de instalación y actividad de procesos atribuibles.';Description='Devuelve un resumen VSO.Status con Kind Summary e InstallationState NotInstalled cuando ninguna instalación coincide. Es un resultado de consulta, no un registro de instalación. Los datos ausentes son null y Running es booleano (null si falta visibilidad). La presentación nativa está localizada; Select-Object y JSON conservan los datos originales. Scope y Version filtran la consulta; un resultado filtrado vacío no prueba ausencia global. Path admite cadenas o propiedades Path por canalización. Estado estructurado de solo lectura. ProcessState Unknown significa visibilidad insuficiente; Idle solo indica que no se ha encontrado un proceso atribuible con la evidencia disponible. No consulta actualizaciones por Internet ni afirma que VSO completó su arranque. Sin confirmaciones ni escrituras.';Examples=@(@{Title='Estado';Code='Get-VSOStatus -Quiet | Format-List';Remarks='Incluye diagnóstico y fiabilidad de visibilidad de procesos.'})}
    'Reset-VSO'=@{Synopsis='Elimina archivos propios y conserva Recovery de Windows y datos desconocidos.';Description='La aplicación y el módulo se desinstalan por separado. Reset-VSO elimina la aplicación; Reset-VSO -Full incluye más datos atribuibles. Uninstall-PSResource VSO elimina el módulo, o Uninstall-Module VSO si usaste PowerShellGet. Ninguna de esas acciones elimina el otro componente. Consulta primero WhatIf y PassThru. Muestra listas exactas de eliminación y conservación. El reset normal elimina aplicación, recibo y registro coincidente, conservando datos persistentes registrados. Full incluye configuración, caché, logs, temporales registrados sin cambios y metadatos de transacciones atribuibles. Protected identifica motivo y propiedad de cada elemento conservado; no se afirma limpieza total de datos compartidos o sin registro. Conserva archivos modificados y ajenos. Full no puede atribuir ProgramData compartido de VSO7 ni datos no registrados a una instalación, por lo que los conserva. RemoveBackups y AcknowledgeBackupLoss autorizan eliminar copias anteriores propias. La eliminación en Quiet o sin interacción requiere Force. Desinstalar archivos no revierte tweaks de Windows. El módulo de Gallery sigue instalado.';Examples=@(@{Title='Ver el plan exacto';Code='Reset-VSO -Path "D:\Programs\VSO" -Full -WhatIf -PassThru';Remarks='Revisa Remove, Preserve y Protected (motivo y propiedad).'},@{Title='Eliminar la aplicación';Code='Reset-VSO -Path "D:\Programs\VSO" -Quiet -Force -PassThru';Remarks='Conserva Recovery compartido y archivos sin propiedad demostrada.'},@{Title='Eliminar backups del gestor explícitamente';Code='Reset-VSO -Full -RemoveBackups -AcknowledgeBackupLoss -Confirm';Remarks='También elimina archivos anteriores propios, conservando contenido desconocido.'},@{Title='Desinstalar el módulo PowerShell';Code='Uninstall-PSResource VSO';Remarks='Con PowerShellGet usa Uninstall-Module VSO. La aplicación se conserva. Cierra las sesiones que hayan importado el módulo antes de desinstalarlo.'})}
    'Help-VSO'=@{Synopsis='Muestra ayuda localizada, sintaxis, parámetros y ejemplos.';Description='El resumen también explica cómo eliminar la aplicación y el módulo. Examples requiere Command. Get-Help -Full presenta los ejemplos después de NOTAS sin un encabezado general de ejemplos; los títulos numerados los distinguen. Get-Help -Examples selecciona únicamente los ejemplos estructurados. Usa español para culturas españolas e inglés para las restantes. Language cambia el idioma de Help-VSO. Get-Help usa MAML externo generado en en-US y es-ES, con copia inglesa de respaldo en la raíz; Get-Help selecciona la cultura de sesión, no el parámetro Language. Toda la ayuda procede de las mismas descripciones estructuradas.';Examples=@(@{Title='Ayuda en español';Code='Help-VSO -Command Install-VSO -Language es';Remarks='Selección explícita de idioma.'},@{Title='Ayuda nativa';Code='Get-Help Reset-VSO -Full';Remarks='Usa la selección nativa de cultura de PowerShell.'})}
}
